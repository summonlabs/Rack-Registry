@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Rack Registry has no third-party dependencies: it is C++20 standard library
# only. A consumer therefore needs nothing beyond the imported target below.
include("${CMAKE_CURRENT_LIST_DIR}/RackRegistryTargets.cmake")

check_required_components(RackRegistry)

set(RackRegistry_VERSION "@PROJECT_VERSION@")
set(RackRegistry_STATE_FORMAT_VERSION "1")
